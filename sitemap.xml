---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for page in site.pages %}
    {% if page.url == nil %}
      {% continue %}
    {% endif %}
    {% if page.url contains '/assets/' or page.url contains '/components/' or page.url contains '/_includes/' or page.url contains '/_layouts/' %}
      {% continue %}
    {% endif %}
    {% if page.name == "robots.txt" or page.name == "sitemap.xml" %}
      {% continue %}
    {% endif %}
    {% if page.url contains '.css' or page.url contains '.js' %}
      {% continue %}
    {% endif %}
  <url>
    <loc>{{ page.url | absolute_url }}</loc>
    <changefreq>weekly</changefreq>
    <priority>{% if page.url == "/" or page.url == "/index.html" %}1.0{% else %}0.8{% endif %}</priority>
  </url>
  {% endfor %}
</urlset>

